# LiveKit — same values livekit-token / captions-start use.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase Postgres, SESSION-mode connection string (Shared Pooler, port 5432).
# Must support LISTEN — the transaction pooler (port 6543) does not.
DATABASE_URL=

# Deepgram streaming speech-to-text.
DEEPGRAM_API_KEY=

# Optional overrides (defaults shown).
# CAPTION_DEEPGRAM_MODEL_EN=nova-3
# CAPTION_DEEPGRAM_MODEL=nova-2
# CAPTION_IDLE_STOP_MINUTES=3
# CAPTION_NO_SPEECH_STOP_MINUTES=30
# CAPTION_ORG_DAILY_ALERT_MINUTES=3000

# Supabase Realtime broadcast to webinar audiences watching over HLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
