{
  "name": "ministry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:electron": "vite build --mode electron",
    "dist:win": "vite build --mode electron && electron-builder --win",
    "lint": "eslint .",
    "preview": "vite preview",
    "mobile:sync": "vite build && cap sync",
    "mobile:android": "vite build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@rekindle/auth": "*",
    "@rekindle/features": "*",
    "@rekindle/live": "*",
    "@rekindle/supabase": "*",
    "@rekindle/types": "*",
    "@rekindle/ui": "*",
    "firebase": "^12.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.rekindlebc.ministry",
    "productName": "Rekindle Ministry",
    "electronVersion": "31.7.7",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "!node_modules/**/android/**",
      "!node_modules/**/ios/**",
      "!node_modules/**/*.md",
      "!node_modules/**/*.map",
      "!node_modules/**/{CHANGELOG.md,README.md,readme.md}",
      "!node_modules/**/{test,tests,__tests__,example,examples,.github}/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rekindle Ministry"
    }
  }
}
