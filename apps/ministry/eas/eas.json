{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "node": "24.18.0",
      "env": {
        "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
      },
      "ios": {
        "image": "latest",
        "scheme": "App",
        "buildConfiguration": "Release"
      }
    },
    "adhoc": {
      "extends": "production",
      "distribution": "internal"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6827081620"
      }
    }
  }
}
