# SPA fallback for Apache hosting (Hostinger).
# Serves index.html for any path that isn't a real file/directory so client-side
# routes like /devotional-series/:id, /books/:id, /prayer-series/:id resolve
# instead of returning the host's 404 page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files and directories be served directly (assets, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> the SPA entry point
  RewriteRule ^ /index.html [L]
</IfModule>

# Never let the HTML shell or the service worker be cached by the browser/host —
# they must always revalidate so a new deploy is picked up immediately. The hashed
# JS/CSS in /assets are content-addressed and safe to cache forever (below).
<IfModule mod_headers.c>
  # Security Headers
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(self), camera=(self)"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com https://js.stripe.com https://js.paystack.co https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://vpnpembyqbbaaiynfvli.supabase.co https://d64gsuwffb70l.cloudfront.net https://ui-avatars.com https://lh3.googleusercontent.com https://avatars.githubusercontent.com; media-src 'self' data: blob: https://vpnpembyqbbaaiynfvli.supabase.co; connect-src 'self' https://vpnpembyqbbaaiynfvli.supabase.co wss://vpnpembyqbbaaiynfvli.supabase.co wss://livekit.rekindlebc.com https://livekit.rekindlebc.com wss://*.livekit.cloud https://*.livekit.cloud https://api.stripe.com https://checkout.stripe.com https://api.paystack.co https://fcmregistrations.googleapis.com https://firebaseinstallations.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://bible-api.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://checkout.paystack.com https://js.paystack.co https://accounts.google.com; object-src 'none'; base-uri 'self';"

  # Content-addressed assets (hashed filenames) can cache forever.
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # …but the HTML shell and the service worker must ALWAYS revalidate so a new
  # deploy is picked up immediately. Listed last so this wins over the rule above
  # for sw.js (which also matches \.js$).
  <FilesMatch "(index\.html|sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
