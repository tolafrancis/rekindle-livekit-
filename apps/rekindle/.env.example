# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (web push) — BUILD-TIME config.
# Copy this file to ".env", fill in the real values, then rebuild (npm run build).
# All values below are PUBLIC Firebase web config (they ship in the client bundle);
# the secret sending credential lives only in the Supabase FCM_SERVICE_ACCOUNT.
#
# Where to get them:
#   Firebase Console -> Project settings (gear icon) -> General tab
#     -> "Your apps" -> Web app -> "SDK setup and configuration" -> firebaseConfig
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# VAPID / Web Push certificate PUBLIC key:
#   Firebase Console -> Project settings -> Cloud Messaging tab
#     -> "Web Push certificates" -> Key pair (copy the key string)
VITE_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------------------------
# LiveKit (video/audio) — BUILD-TIME public URL the browser connects to.
# The API key/secret are NEVER here — they live in Supabase function secrets
# (LIVEKIT_API_KEY / LIVEKIT_API_SECRET) and mint tokens server-side (Phase 1).
#   dev (local docker):  ws://localhost:7880
#   prod:                wss://livekit.yourdomain.com
# Infra to run this URL lives in ./livekit (docker-compose + configs).
# ---------------------------------------------------------------------------
VITE_LIVEKIT_URL=

# Which media engine the video-room seam uses. 'daily' (default) keeps the current
# production path; 'livekit' switches to LiveKitRoomWrapper (needs VITE_LIVEKIT_URL
# + the livekit-token edge fn deployed). Flip per-environment during the migration.
VITE_VIDEO_BACKEND=daily

# Which app is running ('rekindle' or 'ministry') - used for OAuth redirect custom URL schemes
VITE_APP_TYPE=rekindle

# ---------------------------------------------------------------------------
# Base URL of the separate Ministry app deployment. The landing page's
# "Become a Ministry Partner" CTA sends visitors to `${VITE_MINISTRY_APP_URL}/settings/billing`
# for account-gated checkout — billing lives in that app, not this one.
# Falls back to https://rekindlebc.com if unset.
# ---------------------------------------------------------------------------
VITE_MINISTRY_APP_URL=https://rekindlebc.com
