# Infra secrets for the self-hosted LiveKit stack (docker-compose).
#
#   cp .env.example .env
#
# .env is gitignored. NOTHING here may be filled in with a real value and
# committed — docker-compose interpolates these into the containers at start,
# which is why config/livekit.yaml has no `keys:` block and egress/ingress have
# no yaml on disk at all.

# ONE shared key/secret pair for SFU + Egress + Ingress.
#
# LIVEKIT_API_KEY is a NAME, not a credential — it travels in plaintext in every
# JWT header, and it must match `webhook.api_key` in config/livekit.yaml.
LIVEKIT_API_KEY=devkey

# The actual credential. MUST be >= 32 chars. Generate a fresh one:
#   openssl rand -hex 32
# Paste the SAME value into the Supabase secret LIVEKIT_API_SECRET, or every
# token the edge functions mint will be rejected with a 401.
LIVEKIT_API_SECRET=

# Public signaling URL the BROWSER connects to.
#   dev (local):  ws://localhost:7880
#   prod:         wss://livekit.yourdomain.com   (TLS terminated by Caddy)
LIVEKIT_URL=ws://localhost:7880

# ---- Egress output storage ------------------------------------------------
# Dev = the MinIO service in compose (these creds CREATE the MinIO root user).
# Prod = real S3/R2: set the endpoint + keys and delete the minio services.
# NOTE: S3_ENDPOINT is resolved from INSIDE the egress container, so for MinIO
# it is the docker service name (http://minio:9000), never localhost.
S3_ACCESS_KEY=
S3_SECRET=
S3_BUCKET=livekit-egress
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
