# Infra secrets for the self-hosted LiveKit stack (docker-compose).
# Copy to livekit/.env and edit. These mirror the values baked into config/*.yaml
# for dev; in prod inject them and remove the plaintext from the yaml files.

# ONE shared key/secret pair for SFU + Egress + Ingress. Secret must be >= 32 chars.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_please_change_me_0123456789abcdef

# Public signaling URL the BROWSER connects to.
#   dev (local):  ws://localhost:7880
#   prod:         wss://livekit.yourdomain.com   (TLS terminated at LB/ingress)
LIVEKIT_URL=ws://localhost:7880

# Egress output storage (dev = MinIO in compose; prod = real S3/GCS/Azure).
S3_ACCESS_KEY=minioadmin
S3_SECRET=minioadmin
S3_BUCKET=livekit-egress
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
